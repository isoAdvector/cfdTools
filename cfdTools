# Scan a dictionary file and, depending on mode, print every entry path (list),
# print one entry's value (get), or print the whole file with one value replaced
# (set, with the new value in $newValue).
#
#   _dictScan <list|get|set> <file> [entry.path] [add]
#
# Entries are addressed by their full path from the top of the file, with sub-dicts
# separated by ".", e.g. "nz", "PIMPLE.nCorrectors", "solvers.p_rgh.tolerance".
# A path matching several entries is refused. get also refuses one matching none;
# set adds the entry in that case if a non-empty add argument was given, and exits
# 2 to say so.
#
# Dictionary syntax is described by six tokens, so supporting another brace-and-
# terminator dialect is a one-line addition to the case statement. Formats that
# express nesting through indentation, such as YAML, do not fit this model.
_dictScan() (

    mode="$1"; file="$2"; entry="$3"

    case ${dictSyntax:-openfoam} in
        openfoam) term=';' dopen='{' dclose='}' lcom='//' bopen='/*' bclose='*/' ;;
        *) echo "unknown dictSyntax '$dictSyntax' (known: openfoam)" >&2; return 1 ;;
    esac

    if [ ! -f "$file" ]; then
        echo "$file: not found" >&2
        return 1
    fi

    # The new value is passed through the environment rather than -v so that awk
    # does not interpret backslash escapes in it.
    awk -v mode="$mode" -v add="${4:-}" \
        -v target="$entry" -v term="$term" -v dopen="$dopen" -v dclose="$dclose" \
        -v lcom="$lcom" -v bopen="$bopen" -v bclose="$bclose" '
    # Scanned as a character stream, not line by line: the syntax is delimited by
    # white space of any kind, so entries and braces may be split over lines or
    # packed onto one.
    BEGIN { value = ENVIRON["newValue"]; lc = length(lcom); bo = length(bopen) }
    # Position of the last "." in t that separates a parent path from a key. Dots
    # inside a quoted name, as in solvers."alpha.water.*".tolerance, are part of
    # the name and are skipped.
    function lastDot(t,   p, i, q, ch) {
        p = 0; q = ""
        for (i = 1; i <= length(t); i++) {
            ch = substr(t, i, 1)
            if (q != "") { if (ch == q) q = "" }
            else if (ch == "\"") q = ch
            else if (ch == ".") p = i
        }
        return p
    }
    # The dotted path of the dictionary enclosing depth d, "" at the top level
    function pathTo(d,   j, r) {
        r = ""
        for (j = 1; j <= d; j++) r = r path[j] (j < d ? "." : "")
        return r
    }
    { s = s $0 "\n" }
    END {
        n = length(s)
        for (i = 1; i <= n; ) {
            c = substr(s, i, 1)
            if (substr(s, i, lc) == lcom || c == "#") {           # comment or #directive
                while (i <= n && substr(s, i, 1) != "\n") i++
            } else if (substr(s, i, bo) == bopen) {               # block comment
                j = index(substr(s, i + bo), bclose)
                i = j ? i + bo + j - 1 + length(bclose) : n + 1
            } else if (c ~ /[ \t\r\n]/) {
                i++
            } else if (c == "\"") {                               # quoted name: one token
                j = index(substr(s, i + 1), "\""); e = j ? i + j : n
                if (!nTok++) { kS = i; kE = e }
                i = e + 1
            } else if (c == "(") {                                # a list opens
                pd++; i++
            } else if (c == ")") {                                # a list closes
                if (pd) pd--
                i++
            } else if (pd) {                                      # inside a list
                i++                                               # it is all value
            } else if (c == dopen) {                              # sub-dict opens
                path[++depth] = nTok ? substr(s, kS, kE - kS + 1) : ""; nTok = 0; i++
            } else if (c == dclose) {                             # sub-dict closes
                if (depth) {
                    delete path[depth--]
                    # A dictionary holding only sub-dicts, as fvSchemes does, has no
                    # entry to append after, so remember the end of each one as a
                    # fallback insertion point for the dictionary enclosing it
                    outer = pathTo(depth)
                    endPos[outer] = i; endDepth[outer] = depth
                }
                nTok = 0; i++
            } else if (c == term) {                               # entry ends
                if (nTok) {
                    parent = pathTo(depth)
                    full = (depth ? parent "." : "") substr(s, kS, kE - kS + 1)

                    if (mode == "set") {
                        # Where the last entry of each dict ends, so a new one can be
                        # appended after it, and the column its value sits in, so an
                        # added entry lines up with the entries around it
                        tailPos[parent] = i; tailDepth[parent] = depth
                        ls = kS; while (ls > 1 && substr(s, ls - 1, 1) != "\n") ls--
                        vs2 = kE + 1
                        while (vs2 <= i && substr(s, vs2, 1) ~ /[ \t]/) vs2++
                        tailInd[parent] = kS - ls; tailCol[parent] = vs2 - ls
                    }
                    # The FoamFile header is noise when browsing, so it is left out
                    # of listings; it can still be read and set by naming it
                    if (mode == "list" && substr(full, 1, 9) != "FoamFile.") print full
                    if (full == target) { matches++; vS = kE + 1; vE = i - 1 }
                }
                nTok = 0; i++
            } else {                                              # ordinary token
                for (j = i; j <= n; j++) {
                    cc = substr(s, j, 1)
                    if (cc ~ /[ \t\r\n"]/ || cc == dopen || cc == dclose || cc == term) break
                    if (substr(s, j, lc) == lcom || substr(s, j, bo) == bopen) break
                }
                if (!nTok++) { kS = i; kE = j - 1 }
                i = j
            }
        }
        if (mode == "list") exit 0

        # Adding a missing entry when asked for. The path given is taken at face
        # value: if the same name exists in some sub-dict the new entry is still
        # added at the path asked for, and it is up to the caller to check that it
        # landed where intended.
        if (mode == "set" && add && matches == 0) {
            k = lastDot(target); key = k ? substr(target, k + 1) : target
            parent = k ? substr(target, 1, k - 1) : ""
            if (parent in tailPos) {
                pos = tailPos[parent]; nInd = tailInd[parent]; nCol = tailCol[parent]
            } else if (parent in endPos) {
                pos = endPos[parent]; nInd = 4 * endDepth[parent]; nCol = nInd + 16
            } else {
                printf "\"%s\": no dictionary \"%s\" to add it to\n", target, parent > "/dev/stderr"
                exit 1
            }
            # Step past a comment trailing the entry we are inserting after, and
            # past any comment lines below it, so the comment stays with the entry
            # it explains rather than being pushed onto the new one
            q = pos + 1
            while (q <= n && substr(s, q, 1) ~ /[ \t\r]/) q++
            if (substr(s, q, lc) == lcom) while (q <= n && substr(s, q, 1) != "\n") q++
            while (q <= n && substr(s, q, 1) == "\n") {
                r = q + 1
                while (r <= n && substr(s, r, 1) ~ /[ \t\r]/) r++
                if (substr(s, r, lc) != lcom) break
                q = r; while (q <= n && substr(s, q, 1) != "\n") q++
            }
            pos = q - 1

            ind = ""; for (d = 0; d < nInd; d++) ind = ind " "
            gap = ""; for (d = nInd + length(key); d < nCol; d++) gap = gap " "
            if (gap == "") gap = " "
            printf "%s\n%s%s%s%s%s%s", substr(s, 1, pos), ind, key, gap, value, term, substr(s, pos + 1)
            exit 2                                        # 2 = added rather than replaced
        }

        if (matches != 1) {
            printf "\"%s\" %s\n", target,
                   matches ? "matched " matches " times - refusing to guess" : "not found" > "/dev/stderr"
            exit 1
        }
        while (substr(s, vS, 1) ~ /[ \t\r\n]/) vS++        # keep the spacing around the value
        while (substr(s, vE, 1) ~ /[ \t\r\n]/) vE--
        if (mode == "get") { print substr(s, vS, vE - vS + 1); exit 0 }
        # An entry may have no value at all, as fluxRequired entries do, so a new
        # value needs a separator, and clearing one must take the separator with it
        e = vS - 1
        if (value == "") while (e >= 1 && substr(s, e, 1) ~ /[ \t]/) e--
        printf "%s%s%s%s", substr(s, 1, e),
               (value != "" && vS > vE ? " " : ""), value, substr(s, vE + 1)
    }' "$file"
)


# Print every entry path in a dictionary file
#
#   listDictEntries <file>
listDictEntries() ( _dictScan list "$1" )


# Print the value of one entry
#
#   getDictEntry <file> <entry.path>
getDictEntry() (
    [ $# -eq 2 ] || { echo "Usage: getDictEntry <file> <entry.path>" >&2; return 1; }
    _dictScan get "$1" "$2" || { echo "    in file: $1" >&2; return 1; }
)


# Set one entry, rewriting only the value and leaving the rest of the file untouched
# (comments, formatting, floating point precision). A file that ends without a
# newline gains one, which is the only byte the parser does not preserve.
#
#   setDictEntry [-add] <file> <entry.path> <value>
#
# Without -add only entries that already exist are modified, so a mistyped name is
# reported rather than quietly creating a new entry. This is what parmScanner
# relies on. With -add a missing entry is created instead, placed after the last
# entry of its dictionary and indented to match. The dictionary it belongs to must
# already exist. Returns 2 when an entry was added, 0 when one was replaced.
setDictEntry() (
    addMissing=
    [ "$1" = "-add" ] && { addMissing=1; shift; }
    [ $# -eq 3 ] || { echo "Usage: setDictEntry [-add] <file> <entry.path> <value>" >&2; return 1; }

    tmp="$1.setDictEntry.$$"
    newValue="$3" _dictScan set "$1" "$2" "$addMissing" > "$tmp"
    status=$?
    if [ $status -eq 0 ] || [ $status -eq 2 ]; then
        # Writing through cat rather than mv keeps the file's mode and ownership.
        # A read-only file fails here, and that must not be reported as a success.
        if cat "$tmp" > "$1"; then
            rm -f "$tmp"
            return $status
        fi
        echo "    could not write $1" >&2
        rm -f "$tmp"
        return 1
    fi
    rm -f "$tmp"
    echo "    in file: $1" >&2
    return 1
)


# Inspect and change dictionary parameters with tab completion:
# See help text for intended behaviour
dictator() {
    if [ "$1" = "-help" ]; then
        cat <<'HELP'
Inspect and set values in OpenFOAM dictionaries with auto-completion. 
Copyright (C) 2026 Johan Roenby, STROMNING.
Usage: dictator <dictFile> <parameter> [value]

  Examples:
    dictator sys[TAB]                            completes to system/
    dictator system/con[TAB]                     completes to system/controlDict
    dictator system/controlDict [TAB]            lists all parameters in dict
    dictator system/controlDict start[TAB]       lists e.g. startFrom, startTime
    dictator system/controlDict startTime [TAB]  displays startTime value
    dictator system/controlDict startTime 12     sets startTime to 12
    dictator system/controlDict banana ripe      adds "banana  ripe;"
    dictator system/fvSolution PIMPLE.[TAB]      lists PIMPLE.nCorrectors, ...
    dictator constant/transportProperties [TAB]  lists phases, water., air., sigma
    dictator system/fvSchemes 'div[TAB]          completes to 'divSchemes.
    dictator system/fvSchemes 'divSchemes.[TAB]r[TAB] -> 'divSchemes.div(rhoPhi,U)'
    dictator system/fvSolution 'solvers."pc[TAB] -> 'solvers."pcorr.*".

Notes:
  Sub-dicts keep a trailing "." so that TAB steps into them.
  Names holding ( ) or * need quoting. Open a quote and TAB as usual; the closing
  quote is automatically added once the name is complete.
  The FoamFile header is left out of listings but can still be read by name.
  See "parmScanner -help" for setDictEntry, getDictEntry and listDictEntries.
HELP
        return 0
    fi
    case $# in
        2) getDictEntry "$1" "$2" ;;
        3) # -add: at the keyboard a missing parameter is usually one you want
           # created. The distinct "Added" message is what catches a typo.
           setDictEntry -add "$1" "$2" "$3"
           case $? in
               0) echo "Set   $2 = $3 in $1" ;;
               2) echo "Added $2 = $3 in $1" ;;
               *) return 1 ;;
           esac ;;
        *) echo "Usage: dictator <dictFile> <parameter> [value]" >&2; return 1 ;;
    esac
}

# Echo the entries and sub-dict names one level below the path prefix given, i.e.
# the contents of the dictionary already drilled into. A sub-dict keeps its
# trailing "." so that the next TAB steps inside it. Dots within a quoted name
# are not separators.
_dictator_level() {
    listDictEntries "$1" 2>/dev/null | awk -v cur="$2" '
        function nextDot(t, from,   i, q, ch) {
            q = ""
            for (i = from; i <= length(t); i++) {
                ch = substr(t, i, 1)
                if (q != "") { if (ch == q) q = "" }
                else if (ch == "\"") q = ch
                else if (ch == ".") return i
            }
            return 0
        }
        BEGIN {
            last = 0; p = 1
            while ((d = nextDot(cur, p)) > 0) { last = d; p = d + 1 }
            base = last ? substr(cur, 1, last) : ""
            bl = length(base)
        }
        index($0, base) == 1 {
            rest = substr($0, bl + 1)
            d = nextDot(rest, 1)
            cand = base (d ? substr(rest, 1, d) : rest)
            if (index(cand, cur) == 1 && !(cand in seen)) { seen[cand] = 1; print cand }
        }'
}


_dictator_complete() {
    # Two readline facts shape this function. First, COMP_WORDS is split on
    # COMP_WORDBREAKS, which contains "(" and ":", so a name like
    # divSchemes.div(rhoPhi,U) is torn apart; the line is re-parsed here instead.
    # Second, bash runs no completion function at all once an unquoted "(" is on
    # the line, so a name containing one has to reach the line already quoted.
    # Inside a quote the name is offered as it is; otherwise it is escaped with
    # printf %q, which puts a backslash on the line at the first TAB and keeps
    # later TABs working.
    local line="${COMP_LINE:0:$COMP_POINT}" ch quote= word= i
    local -a args=()
    for (( i = 0; i < ${#line}; i++ )); do
        ch="${line:i:1}"
        if [[ $ch == '\' && $quote != "'" ]]; then
            (( i++ )); word+="${line:i:1}"     # a backslash escapes the next character
        elif [[ -n $quote ]]; then
            [[ $ch == "$quote" ]] && quote= || word+=$ch
        elif [[ $ch == "'" || $ch == '"' ]]; then
            quote=$ch
        elif [[ $ch == " " ]]; then
            [[ -n $word ]] && args+=("$word")
            word=
        else
            word+=$ch
        fi
    done
    args+=("$word")                       # the word being completed, possibly empty

    local file="${args[1]}" cur="$word" c
    local inQuote=$quote                  # a quote is still open on this word
    local raw="$cur"                      # the parser already removed any escaping
    COMPREPLY=()

    case $(( ${#args[@]} - 1 )) in
        1)  # A dictionary file. -o filenames appends "/" after a directory so the
            # path can be typed on, and a space after a file so TAB moves on.
            compopt -o filenames 2>/dev/null
            COMPREPLY=( $(compgen -f -- "$cur") )
            ;;
        2)  # Any parameter path in that file. A name needing quotes is shown
            # quoted while the whole list is on display, which reads far better
            # than backslashes, and is escaped with %q once a partial word is
            # being extended, because readline only accepts a candidate that
            # continues the word it thinks is being completed.
            [[ -f "$file" ]] || return
            [[ -n $inQuote || -z $cur ]] && compopt -o noquote 2>/dev/null

            local -a lvl=()
            while IFS= read -r c; do lvl+=( "$c" ); done < <(_dictator_level "$file" "$raw")
            (( ${#lvl[@]} )) || return

            # Readline closes an opened quote as soon as the match is unique, which
            # would end the quoted word mid-path and leave the rest to be escaped.
            # No compopt suppresses that, so when the sole match is a sub-dict the
            # level below it is offered too: the completion stays ambiguous, the
            # common prefix is still the sub-dict, and the quote stays open.
            if [[ -n $inQuote && ${#lvl[@]} -eq 1 && ${lvl[0]} == *. ]]; then
                while IFS= read -r c; do lvl+=( "$c" ); done < <(_dictator_level "$file" "${lvl[0]}")
            fi

            for c in "${lvl[@]}"; do
                if   [[ -n $inQuote ]];                            then COMPREPLY+=( "$c" )
                elif [[ -z $cur && $c == *[^A-Za-z0-9._/-]* ]];    then COMPREPLY+=( "'$c'" )
                else                                                    COMPREPLY+=( "$(printf '%q' "$c")" )
                fi
            done
            # A lone sub-dict must not get a space after it, so TAB can step inside
            [[ ${#COMPREPLY[@]} -eq 1 && ${COMPREPLY[0]} == *. ]] && compopt -o nospace 2>/dev/null
            ;;
        3)  # Offer the parameter's current value as the starting point, shown by
            # the same rule as the names above: quoted while it is the whole
            # suggestion, escaped only when a partial word is being extended.
            [[ -f "$file" ]] || return
            c=$(getDictEntry "$file" "${args[2]}" 2>/dev/null) || return
            [[ $c == "$raw"* ]] || return
            [[ -n $inQuote || -z $cur ]] && compopt -o noquote 2>/dev/null
            if   [[ -n $inQuote ]];                         then COMPREPLY=( "$c" )
            elif [[ -z $cur && $c == *[^A-Za-z0-9._/-]* ]]; then COMPREPLY=( "'$c'" )
            else                                                 COMPREPLY=( "$(printf '%q' "$c")" )
            fi
            ;;
    esac
}

complete -F _dictator_complete dictator


# Make a sequence of copies of baseCase and change one or more parameters in the
# setup files of each case according to the values in a parameter file.
#
# Example of the parameter file format:
#
# scanName                      myParmScan
# baseCase                      myBaseCase
# water.nu                      ddtSchemes.default          nx
# constant/transportProperties  system/fvSchemes            system/blockMeshDict
# 1e00                          Euler                       20
# 1e-01                         "CrankNicolson      0.9"    20
# 1e-02                         "CrankNicolson      0.7"    40
# 1e-03                         "CrankNicolson      0.6"    40
# 1e-04                         "CrankNicolson      0.5"    80
#
# First line is the name of the scan - a dir will be created.
# Second line is the name of the base case from which scan cases will be derived.
# Third line contains white space separated parameter names (use "." for subDicts).
# Fourth line are the files in which the parameters are found.
# Subsequent lines specify parameters (use double quotation if to include white space)
#
# Todo:
# -Make robust against variations in parmFile format
# -Enable different delimiters
# -Enable sending to queue system
#
# The body is a subshell, so variables and cd's stay local and backgrounded cases
# keep running after it returns.
parmScanner() (

    # "read -d ''" below reports failure even when it succeeds, so a caller running
    # under "set -e" would abort the scan. Errors are checked explicitly instead.
    set +e

    # If no arguments print help
    if [[ $# -eq 0 ]]; then
        parmScanner -help
        return 1
    fi

    # Base case to be copied and modified to create test matrix
    baseCase=baseCase
    # Name of file containing list of parameters to change and values
    parmScanFile=parmFile
    # Prefix name of created numbered test cases
    scanName=parmScan
    # Script to execute in each created case
    execScript=
    # Whether to run cases in parallel (background)
    runParallel=false
    # Max number of simultaneously running cases
    maxJobs=0  # 0 means no limit

    # Parse command line arguments
    while [[ $# -gt 0 ]]; do
        key="$1"
        case $key in
            -file)
                parmScanFile="$2"
                shift
                shift
                ;;
            -exec)
                execScript="$2"
                shift
                shift
                ;;
            -parallel)
                runParallel=true
                shift
                ;;
            -maxJobs)
                maxJobs="$2"
                shift
                shift
                ;;
            -help)
                # Print documentation text from README
                cat "$_CFDTOOLS_DIR/README"
                return 0
                ;;
            *)
                echo "Unknown option: $1" >&2
                return 1
                ;;
        esac
    done

    if [ ! -f "$parmScanFile" ]; then
        echo "ERROR: parameter file '$parmScanFile' not found" >&2
        return 1
    fi
    if [ "$runParallel" = false ] && (( maxJobs > 0 )); then
        echo "WARNING: -maxJobs has no effect without -parallel" >&2
    fi

    # Reading scan name from 1st line of parm file and making scan directory
    scanNameString=($(sed -n '1p' "$parmScanFile"))
    scanName=${scanNameString[1]}
    # Making dir for scan cases
    mkdir -p "$scanName"

    # Reading baseCase name from 2nd line of parm file and copying case into scan dir
    baseCaseString=($(sed -n '2p' "$parmScanFile"))
    baseCase=${baseCaseString[1]}
    if [ ! -d "$baseCase" ]; then
        echo "ERROR: baseCase '$baseCase' not found (named on line 2 of $parmScanFile)" >&2
        return 1
    fi
    # Archive copies are write-once: a rerun must not nest a new copy inside the
    # existing one, nor overwrite the record of how the scan was originally defined.
    # basename so that -file some/dir/parms.csv still lands inside the scan dir.
    [ -e "${scanName}/${baseCase}.copy" ] || cp -r "$baseCase" "${scanName}/${baseCase}.copy"
    [ -e "${scanName}/$(basename "$parmScanFile").copy" ] || \
        cp "$parmScanFile" "${scanName}/$(basename "$parmScanFile").copy"

    # Reading list of parameters to change
    parmNames=($(sed -n '3p' "$parmScanFile"))
    # For each parameter, which case file is it found in?
    parmFiles=($(sed -n '4p' "$parmScanFile"))
    if [ ${#parmNames[@]} -eq 0 ] || [ ${#parmNames[@]} -ne ${#parmFiles[@]} ]; then
        echo "ERROR: line 3 of $parmScanFile lists ${#parmNames[@]} parameter name(s) but" >&2
        echo "       line 4 lists ${#parmFiles[@]} file(s). They must match and be non-empty." >&2
        return 1
    fi
    # Length of list of new cases to be generated (ignore empty lines including trailing ones)
    nCases=$(($(grep -v '^[[:space:]]*$' "$parmScanFile" | wc -l) - 4))
    echo nCases: $nCases
    # Fixed width, so that growing a scan past a power of ten does not renumber the
    # cases that already exist. Assumes fewer than 10000 cases.
    nDigits=4

    # Running through cases first to generate them and then execute script
    # if needed
    casesCreated=false
    local bgPids=()
    trap 'kill "${bgPids[@]}" 2>/dev/null; wait "${bgPids[@]}" 2>/dev/null' INT TERM
    for ((j=0; j<2; j++)); do #Creating cases in 1st pass, executing them in 2nd
        #Line to read in parm file 
        parmLineNumber=4
        for ((i=0; i<nCases; i++)); do
            caseNumber=$(printf "%0${nDigits}d" "$i")
            # Go to next parameter line in parm file ignoring pure white space lines
            while :; do
                parmLineNumber=$((parmLineNumber + 1))
                caseParmString=$(sed -n "${parmLineNumber}p" "$parmScanFile")

                # If the line is NOT only whitespace, stop the loop
                if [[ ! "$caseParmString" =~ ^[[:space:]]*$ ]]; then
                    break
                fi
            done
            #Read case parm line treating content of double quotation as single field
            IFS=$'\n' read -r -d '' -a caseParms < <(echo "$caseParmString" | xargs -n 1)
            #Name of current case directory
            caseName=${scanName}/${caseNumber}

            # Creating case that do not already exist
            if [ ! -d "$caseName" ] && [ "$casesCreated" = false ]; then
                echo Creating case $caseName
                cp -r $baseCase $caseName
                # Writing case parameters to parmScannerParms file in case dir
                caseParmFile=$caseName/parmScannerParms
                echo -n "$caseName: " >> $caseParmFile
                # Running through all parameters to be changed in specific case
                for m in ${!parmNames[*]}
                do
                    parmName=${parmNames[$m]}
                    parmFile=${parmFiles[$m]}
                    parmValue=${caseParms[$m]}
                    echo -n "    $parmName: $parmValue" >> $caseParmFile
                    # Changing parameter in specified file. Failures must be loud:
                    # otherwise the case silently keeps the baseCase value while
                    # parmScannerParms claims the requested one.
                    if ! setDictEntry "${caseName}/${parmFile}" "$parmName" "$parmValue"
                    then
                        echo >> $caseParmFile
                        echo "ERROR: aborting scan while creating $caseName" >&2
                        return 1
                    fi
                done
                # Adding new line to caseParmFile
                echo >> $caseParmFile
                # Writing case parms to terminal
                cat $caseParmFile
                # Adding case numer and parms to parmScannerParms in scan dir
                cat $caseParmFile >> $scanName/parmScannerParms
            fi

            # Running execScript in case if specified by user
            if [ "$casesCreated" = true ] && [ -n "$execScript" ]; then
                # A case is run at most once. The log.$execScript file is created by the
                # output redirection below, i.e. the moment the job is launched, so cases
                # that are still running are skipped too. Remove it to rerun a case.
                if [ -f "$caseName/log.$execScript" ]; then
                    echo "Skipping $caseName ($execScript already run - remove log.$execScript to rerun)"
                # Running several jobs simultaneously in the background if specified by the user
                elif [ "$runParallel" = true ]; then
                    # Limiting the number of simultaneous background jobs to maxJobs if specified by the user
                    if (( maxJobs > 0 )); then
                        while true; do
                            local running=0
                            for pid in "${bgPids[@]}"; do
                                kill -0 "$pid" 2>/dev/null && (( running++ )) || true
                            done
                            (( running < maxJobs )) && break
                            echo "Reached max parallel jobs ($maxJobs). Waiting..."
                            sleep 10
                        done
                    fi
                    echo "Running script $execScript in $caseName"
                    ( cd "$caseName" && ./"$execScript" > "log.$execScript" 2>&1 ) &
                    bgPids+=($!)
                else # Run jobs one at a time in the foreground
                    echo "Running script $execScript in $caseName"
                    ( cd "$caseName" && ./"$execScript" 2>&1 | tee "log.$execScript" )
                fi
            fi
        done
        casesCreated=true
    done
    if [ "$runParallel" = true ] && (( ${#bgPids[@]} > 0 )); then
        wait "${bgPids[@]}"
    fi
)


# Function to align columns in parameter file for readability
# Known limitation: Currently does not respect double quotation

columnAlign() {
    local input_file="$1"
    if [ $# -ne 1 ]; then
        echo "Usage: columnAlign <filename>"
        return 1
    fi

    if [ ! -f "$input_file" ]; then
        echo "Error: File $input_file not found"
        return 1
    fi

    local temp_file
    temp_file=$(mktemp)
    local max_cols=0
    local -a max_widths

    # First pass: Determine the number of columns and their maximum widths
    while IFS= read -r line; do
        [ -z "$line" ] && continue
        local col_values
        read -ra col_values <<< "$line"
        local cols=${#col_values[@]}
        (( cols > max_cols )) && max_cols=$cols
        for ((i=0; i<cols; i++)); do
            local width=${#col_values[$i]}
            if [ "${max_widths[$i]:-0}" -lt "$width" ]; then
                max_widths[$i]=$width
            fi
        done
    done < "$input_file"

    # Second pass: Format the output with proper spacing
    while IFS= read -r line; do
        if [ -z "$line" ]; then
            echo "" >> "$temp_file"
            continue
        fi
        local col_values
        read -ra col_values <<< "$line"
        local formatted_line=""
        for ((i=0; i<${#col_values[@]}; i++)); do
            local value=${col_values[$i]}
            formatted_line+="$value"
            if [ $i -lt $((max_cols - 1)) ] && [ $i -lt $((${#col_values[@]} - 1)) ]; then
                local padding=$((max_widths[$i] - ${#value} + 2))
                for ((j=0; j<padding; j++)); do
                    formatted_line+=" "
                done
            fi
        done
        echo "$formatted_line" >> "$temp_file"
    done < "$input_file"

    mv "$temp_file" "$input_file"
    echo "File $input_file has been aligned successfully."
}

