#!/bin/bash

# These tools use bash arrays, which are indexed differently in other shells, so
# refuse to be sourced by anything else rather than silently misbehave.
if [ -z "${BASH_VERSION:-}" ]; then
    echo "cfdTools: requires bash (source it from bash)" >&2
    return 1 2>/dev/null || exit 1
fi

_CFDTOOLS_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Make a sequence of copies of baseCase and change one or more parameters in the
# setup files of each case according the the values in a parameter file.
#
# Example of the parameter file format:
#
# scanName                      myParmScan
# baseCase                      myBaseCase
# water.nu                      ddtSchemes.default          nx
# constant/transportProperties  system/fvSchemes            system/blockMeshDict
# 1e00                          Euler                       20
# 1e-01                         "CrankNicolson      0.9"    20
# 1e-02                         "CrankNicolson      0.7"    40
# 1e-03                         "CrankNicolson      0.6"    40
# 1e-04                         "CrankNicolson      0.5"    80
#
# First line is the name of the scan - a dir will be created.
# Second line is the name of the base case from which scan cases will be derived.
# Third line contains white space separated parameter names (use "." for subDicts).
# Fourth line are the files in which the parameters are found.
# Subsequent lines specify parameters (use double quotation if to include white space)
#
# Copyright Johan Roenby, 2025
#
# Todo:
# -Make robust against variations in parmFile format
# -Enable different delimiters
# -Enable sending to queue system


# Set a single entry in a dictionary file, editing only the line that holds it and
# leaving every other byte of the file untouched (comments, formatting, precision).
#
#   setDictEntry [-syntax <name>] <file> <entry.path> <value>
#
# The entry is addressed by its full path from the top of the file, with sub-dicts
# separated by ".", e.g. "nz" or "PIMPLE.nCorrectors" or "solvers.p_rgh.tolerance".
# The path must match exactly one entry: if it matches none or several, nothing is
# written and a non-zero status is returned. Entries inside comments are ignored.
#
# Only modifies entries that already exist. Adding or removing entries is
# deliberately not supported: the base case then documents what can be scanned.
#
# Dictionary syntax is described by six tokens, so supporting another brace-and-
# terminator dialect is a one-line addition to the case statement below. Formats
# that express nesting through indentation, such as YAML, do not fit this model.
setDictEntry() (

    syntax=openfoam
    while [[ $# -gt 0 ]]; do
        case $1 in
            -syntax) syntax="$2"; shift 2 ;;
            -*)      echo "setDictEntry: unknown option: $1" >&2; return 1 ;;
            *)       break ;;
        esac
    done

    if [[ $# -ne 3 ]]; then
        echo "Usage: setDictEntry [-syntax <name>] <file> <entry.path> <value>" >&2
        return 1
    fi
    file="$1"; entry="$2"; value="$3"

    case $syntax in
        openfoam) term=';' dopen='{' dclose='}' lcom='//' bopen='/*' bclose='*/' ;;
        *) echo "setDictEntry: unknown syntax '$syntax' (known: openfoam)" >&2; return 1 ;;
    esac

    if [ ! -f "$file" ]; then
        echo "setDictEntry: file '$file' not found" >&2
        return 1
    fi

    tmp="${file}.setDictEntry.$$"
    # Value passed through the environment rather than -v so that awk does not
    # interpret backslash escapes in it.
    if newValue="$value" awk \
        -v target="$entry" -v term="$term" -v dopen="$dopen" -v dclose="$dclose" \
        -v lcom="$lcom" -v bopen="$bopen" -v bclose="$bclose" '
    # Scanned as a character stream, not line by line: the syntax is delimited by
    # white space of any kind, so entries and braces may be split over lines or
    # packed onto one.
    BEGIN { value = ENVIRON["newValue"]; lc = length(lcom); bo = length(bopen) }
    { s = s $0 "\n" }
    END {
        n = length(s)
        for (i = 1; i <= n; ) {
            c = substr(s, i, 1)
            if (substr(s, i, lc) == lcom || c == "#") {           # comment or #directive
                while (i <= n && substr(s, i, 1) != "\n") i++
            } else if (substr(s, i, bo) == bopen) {               # block comment
                j = index(substr(s, i + bo), bclose)
                i = j ? i + bo + j - 1 + length(bclose) : n + 1
            } else if (c ~ /[ \t\r\n]/) {
                i++
            } else if (c == "\"") {                               # quoted name: one token
                j = index(substr(s, i + 1), "\""); e = j ? i + j : n
                if (!nTok++) { kS = i; kE = e }
                i = e + 1
            } else if (c == dopen) {                              # sub-dict opens
                path[++depth] = nTok ? substr(s, kS, kE - kS + 1) : ""; nTok = 0; i++
            } else if (c == dclose) {                             # sub-dict closes
                if (depth) delete path[depth--]; nTok = 0; i++
            } else if (c == term) {                               # entry ends
                if (nTok) {
                    full = ""
                    for (d = 1; d <= depth; d++) full = full path[d] "."
                    full = full substr(s, kS, kE - kS + 1)
                    if (full == target) { matches++; vS = kE + 1; vE = i - 1 }
                    else if (index(full, target)) seen[++nSeen] = full
                }
                nTok = 0; i++
            } else {                                              # ordinary token
                for (j = i; j <= n; j++) {
                    cc = substr(s, j, 1)
                    if (cc ~ /[ \t\r\n"]/ || cc == dopen || cc == dclose || cc == term) break
                    if (substr(s, j, lc) == lcom || substr(s, j, bo) == bopen) break
                }
                if (!nTok++) { kS = i; kE = j - 1 }
                i = j
            }
        }
        if (matches != 1) {
            printf "setDictEntry: \"%s\" %s\n", target,
                   matches ? "matched " matches " times - refusing to guess" : "not found" > "/dev/stderr"
            for (k = 1; k <= nSeen; k++)
                printf "              did you mean \"%s\" ?\n", seen[k] > "/dev/stderr"
            exit 1
        }
        while (substr(s, vS, 1) ~ /[ \t\r\n]/) vS++        # keep the spacing around the value
        while (substr(s, vE, 1) ~ /[ \t\r\n]/) vE--
        printf "%s%s%s", substr(s, 1, vS - 1), value, substr(s, vE + 1)
    }' "$file" > "$tmp"
    then
        cat "$tmp" > "$file"   # preserves the original file mode and ownership
        rm -f "$tmp"
        return 0
    else
        rm -f "$tmp"
        echo "              in file: $file" >&2
        return 1
    fi
)


# Subshell body: variables and cd's stay local, backgrounded cases keep running.
parmScanner() (

    # Do not inherit "set -e" from the caller: "read -d ''" below always reports
    # failure even when it succeeds, which would abort the scan. Errors are
    # checked and reported explicitly instead. Confined to this subshell.
    set +e

    # If no arguments print help
    if [[ $# -eq 0 ]]; then
        parmScanner -help
        return 1
    fi

    # Base case to be copied and modified to create test matrix
    baseCase=baseCase
    # Name of file containing list of parameters to change and values
    parmScanFile=parmFile
    # Prefix name of created numbered test cases
    scanName=parmScan
    # Script to execute in each created case
    execScript=
    # Whether to run cases in parallel (background)
    runParallel=false
    # Max number of simultaneously running cases
    maxJobs=0  # 0 means no limit

    # Parse command line arguments
    while [[ $# -gt 0 ]]; do
        key="$1"
        case $key in
            -file)
                parmScanFile="$2"
                shift
                shift
                ;;
            -exec)
                execScript="$2"
                shift
                shift
                ;;
            -parallel)
                runParallel=true
                shift
                ;;
            -maxJobs)
                maxJobs="$2"
                shift
                shift
                ;;
            -help)
                # Print documentation text from README
                cat "$_CFDTOOLS_DIR/README"
                return 0
                ;;
            *)
                echo "Unknown option: $1" >&2
                return 1
                ;;
        esac
    done

    if [ ! -f "$parmScanFile" ]; then
        echo "ERROR: parameter file '$parmScanFile' not found" >&2
        return 1
    fi
    if [ "$runParallel" = false ] && (( maxJobs > 0 )); then
        echo "WARNING: -maxJobs has no effect without -parallel" >&2
    fi

    # Reading scan name from 1st line of parm file and making scan directory
    scanNameString=($(sed -n '1p' "$parmScanFile"))
    scanName=${scanNameString[1]}
    # Making dir for scan cases
    mkdir -p "$scanName"

    # Reading baseCase name from 2nd line of parm file and copying case into scan dir
    baseCaseString=($(sed -n '2p' "$parmScanFile"))
    baseCase=${baseCaseString[1]}
    if [ ! -d "$baseCase" ]; then
        echo "ERROR: baseCase '$baseCase' not found (named on line 2 of $parmScanFile)" >&2
        return 1
    fi
    # Archive copies are write-once: a rerun must not nest a new copy inside the
    # existing one, nor overwrite the record of how the scan was originally defined.
    # basename so that -file some/dir/parms.csv still lands inside the scan dir.
    [ -e "${scanName}/${baseCase}.copy" ] || cp -r "$baseCase" "${scanName}/${baseCase}.copy"
    [ -e "${scanName}/$(basename "$parmScanFile").copy" ] || \
        cp "$parmScanFile" "${scanName}/$(basename "$parmScanFile").copy"

    # Reading list of parameters to change
    parmNames=($(sed -n '3p' "$parmScanFile"))
    # For each parameter, which case file is it found in?
    parmFiles=($(sed -n '4p' "$parmScanFile"))
    if [ ${#parmNames[@]} -eq 0 ] || [ ${#parmNames[@]} -ne ${#parmFiles[@]} ]; then
        echo "ERROR: line 3 of $parmScanFile lists ${#parmNames[@]} parameter name(s) but" >&2
        echo "       line 4 lists ${#parmFiles[@]} file(s). They must match and be non-empty." >&2
        return 1
    fi
    # Length of list of new cases to be generated (ignore empty lines including trailing ones)
    nCases=$(($(grep -v '^[[:space:]]*$' "$parmScanFile" | wc -l) - 4))
    echo nCases: $nCases
    # Number of digits for padding numbers in new case names
    # nDigits=$(( ${#nCases} + 2 ))
    # Note: The above did not work as intended. If starting with 6 cases and then
    # later expanding to 11, 6 first will be recreated with an extra 0 in name.
    # Using instead four digits hardcoded assuming never more than 10000 cases:
    nDigits=4

    # Running through cases first to generate them and then execute script
    # if needed
    casesCreated=false
    local bgPids=()
    trap 'kill "${bgPids[@]}" 2>/dev/null; wait "${bgPids[@]}" 2>/dev/null' INT TERM
    for ((j=0; j<2; j++)); do #Creating cases in 1st pass, executing them in 2nd
        #Line to read in parm file 
        parmLineNumber=4
        for ((i=0; i<nCases; i++)); do
            caseNumber=$(printf "%0${nDigits}d" "$i")
            # Go to next parameter line in parm file ignoring pure white space lines
            while :; do
                parmLineNumber=$((parmLineNumber + 1))
                caseParmString=$(sed -n "${parmLineNumber}p" "$parmScanFile")

                # If the line is NOT only whitespace, stop the loop
                if [[ ! "$caseParmString" =~ ^[[:space:]]*$ ]]; then
                    break
                fi
            done
            #Read case parm line treating content of double quotation as single field
            IFS=$'\n' read -r -d '' -a caseParms < <(echo "$caseParmString" | xargs -n 1)
            #Name of current case directory
            caseName=${scanName}/${caseNumber}

            # Creating case that do not already exist
            if [ ! -d "$caseName" ] && [ "$casesCreated" = false ]; then
                echo Creating case $caseName
                cp -r $baseCase $caseName
                # Writing case parameters to parmScannerParms file in case dir
                caseParmFile=$caseName/parmScannerParms
                echo -n "$caseName: " >> $caseParmFile
                # Running through all parameters to be changed in specific case
                for m in ${!parmNames[*]}
                do
                    parmName=${parmNames[$m]}
                    parmFile=${parmFiles[$m]}
                    parmValue=${caseParms[$m]}
                    echo -n "    $parmName: $parmValue" >> $caseParmFile
                    # Changing parameter in specified file. Failures must be loud:
                    # otherwise the case silently keeps the baseCase value while
                    # parmScannerParms claims the requested one.
                    if ! setDictEntry "${caseName}/${parmFile}" "$parmName" "$parmValue"
                    then
                        echo >> $caseParmFile
                        echo "ERROR: aborting scan while creating $caseName" >&2
                        return 1
                    fi
                done
                # Adding new line to caseParmFile
                echo >> $caseParmFile
                # Writing case parms to terminal
                cat $caseParmFile
                # Adding case numer and parms to parmScannerParms in scan dir
                cat $caseParmFile >> $scanName/parmScannerParms
            fi

            # Running execScript in case if specified by user
            if [ "$casesCreated" = true ] && [ -n "$execScript" ]; then
                # A case is run at most once. The log.$execScript file is created by the
                # output redirection below, i.e. the moment the job is launched, so cases
                # that are still running are skipped too. Remove it to rerun a case.
                if [ -f "$caseName/log.$execScript" ]; then
                    echo "Skipping $caseName ($execScript already run - remove log.$execScript to rerun)"
                # Running several jobs simultaneously in the background if specified by the user
                elif [ "$runParallel" = true ]; then
                    # Limiting the number of simultaneous background jobs to maxJobs if specified by the user
                    if (( maxJobs > 0 )); then
                        while true; do
                            local running=0
                            for pid in "${bgPids[@]}"; do
                                kill -0 "$pid" 2>/dev/null && (( running++ )) || true
                            done
                            (( running < maxJobs )) && break
                            echo "Reached max parallel jobs ($maxJobs). Waiting..."
                            sleep 10
                        done
                    fi
                    echo "Running script $execScript in $caseName"
                    ( cd "$caseName" && ./"$execScript" > "log.$execScript" 2>&1 ) &
                    bgPids+=($!)
                else # Run jobs one at a time in the foreground
                    echo "Running script $execScript in $caseName"
                    ( cd "$caseName" && ./"$execScript" 2>&1 | tee "log.$execScript" )
                fi
            fi
        done
        casesCreated=true
    done
    if [ "$runParallel" = true ] && (( ${#bgPids[@]} > 0 )); then
        wait "${bgPids[@]}"
    fi
)


# Function to align columns in parameter file for readability
# Known limitation: Currently does not respect double quotation

columnAlign() {
    local input_file="$1"
    if [ $# -ne 1 ]; then
        echo "Usage: columnAlign <filename>"
        return 1
    fi

    if [ ! -f "$input_file" ]; then
        echo "Error: File $input_file not found"
        return 1
    fi

    local temp_file
    temp_file=$(mktemp)
    local max_cols=0
    local -a max_widths

    # First pass: Determine the number of columns and their maximum widths
    while IFS= read -r line; do
        [ -z "$line" ] && continue
        local col_values
        read -ra col_values <<< "$line"
        local cols=${#col_values[@]}
        (( cols > max_cols )) && max_cols=$cols
        for ((i=0; i<cols; i++)); do
            local width=${#col_values[$i]}
            if [ "${max_widths[$i]:-0}" -lt "$width" ]; then
                max_widths[$i]=$width
            fi
        done
    done < "$input_file"

    # Second pass: Format the output with proper spacing
    while IFS= read -r line; do
        if [ -z "$line" ]; then
            echo "" >> "$temp_file"
            continue
        fi
        local col_values
        read -ra col_values <<< "$line"
        local formatted_line=""
        for ((i=0; i<${#col_values[@]}; i++)); do
            local value=${col_values[$i]}
            formatted_line+="$value"
            if [ $i -lt $((max_cols - 1)) ] && [ $i -lt $((${#col_values[@]} - 1)) ]; then
                local padding=$((max_widths[$i] - ${#value} + 2))
                for ((j=0; j<padding; j++)); do
                    formatted_line+=" "
                done
            fi
        done
        echo "$formatted_line" >> "$temp_file"
    done < "$input_file"

    mv "$temp_file" "$input_file"
    echo "File $input_file has been aligned successfully."
}