# parmScanner needs setDictEntry. Take it from whatever the user has already
# sourced, so a dictator installed anywhere wins; otherwise look for the
# repository cloned below or beside this one. Failing to find it is fatal rather
# than deferred, because the alternative is a scan that copies every case and
# then dies on the first parameter it tries to set.
if ! declare -F setDictEntry >/dev/null; then
    for _d in "$_CFDTOOLS_DIR/dictator/dictator" \
              "$_CFDTOOLS_DIR/../dictator/dictator"; do
        [ -f "$_d" ] && { . "$_d"; break; }
    done
    unset _d
fi
if ! declare -F setDictEntry >/dev/null; then
    echo "cfdTools: needs dictator, which provides setDictEntry." >&2
    echo "          Get it from https://github.com/isoAdvector/dictator and source" >&2
    echo "          it before cfdTools, or clone it next to this repository." >&2
    return 1 2>/dev/null || exit 1
fi

# Make a sequence of copies of baseCase and change one or more parameters in the
# setup files of each case according to the values in a parameter file.
#
# Example of the parameter file format:
#
# scanName                      myParmScan
# baseCase                      myBaseCase
# water.nu                      ddtSchemes.default          nx
# constant/transportProperties  system/fvSchemes            system/blockMeshDict
# 1e00                          Euler                       20
# 1e-01                         "CrankNicolson      0.9"    20
# 1e-02                         "CrankNicolson      0.7"    40
# 1e-03                         "CrankNicolson      0.6"    40
# 1e-04                         "CrankNicolson      0.5"    80
#
# First line is the name of the scan - a dir will be created.
# Second line is the name of the base case from which scan cases will be derived.
# Third line contains white space separated parameter names (use "." for subDicts).
# Fourth line are the files in which the parameters are found.
# Subsequent lines specify parameters (use double quotation if to include white space)
#
# Todo:
# -Make robust against variations in parmFile format
# -Enable different delimiters
# -Enable sending to queue system
#
# The body is a subshell, so variables and cd's stay local and backgrounded cases
# keep running after it returns.
parmScanner() (

    # "read -d ''" below reports failure even when it succeeds, so a caller running
    # under "set -e" would abort the scan. Errors are checked explicitly instead.
    set +e

    # If no arguments print help
    if [[ $# -eq 0 ]]; then
        parmScanner -help
        return 1
    fi

    # Defaults for the options parsed below. baseCase and scanName are named on
    # lines 2 and 1 of the parameter file and are read from there further down,
    # so the values set here are only ever placeholders.
    baseCase=baseCase
    scanName=parmScan
    # Parameter file to read, overridden by -file
    parmScanFile=parmFile
    # Script to execute in each created case, set by -exec. Empty means create
    # the cases but run nothing.
    execScript=
    runParallel=false   # -parallel
    maxJobs=0           # -maxJobs, 0 means no limit

    # Parse command line arguments
    while [[ $# -gt 0 ]]; do
        key="$1"
        case $key in
            -file)
                parmScanFile="$2"
                shift
                shift
                ;;
            -exec)
                execScript="$2"
                shift
                shift
                ;;
            -parallel)
                runParallel=true
                shift
                ;;
            -maxJobs)
                maxJobs="$2"
                shift
                shift
                ;;
            -help)
                # Print documentation text from README
                cat "$_CFDTOOLS_DIR/README"
                return 0
                ;;
            *)
                echo "Unknown option: $1" >&2
                return 1
                ;;
        esac
    done

    if [ ! -f "$parmScanFile" ]; then
        echo "ERROR: parameter file '$parmScanFile' not found" >&2
        return 1
    fi
    if [ "$runParallel" = false ] && (( maxJobs > 0 )); then
        echo "WARNING: -maxJobs has no effect without -parallel" >&2
    fi

    # Line 1 names the scan, and hence the directory the cases are placed in
    scanNameString=($(sed -n '1p' "$parmScanFile"))
    scanName=${scanNameString[1]}
    mkdir -p "$scanName"

    # Line 2 names the case that every scan case is copied from
    baseCaseString=($(sed -n '2p' "$parmScanFile"))
    baseCase=${baseCaseString[1]}
    if [ ! -d "$baseCase" ]; then
        echo "ERROR: baseCase '$baseCase' not found (named on line 2 of $parmScanFile)" >&2
        return 1
    fi
    # Archive copies are write-once: a rerun must not nest a new copy inside the
    # existing one, nor overwrite the record of how the scan was originally defined.
    # basename so that -file some/dir/parms.csv still lands inside the scan dir.
    [ -e "${scanName}/${baseCase}.copy" ] || cp -r "$baseCase" "${scanName}/${baseCase}.copy"
    [ -e "${scanName}/$(basename "$parmScanFile").copy" ] || \
        cp "$parmScanFile" "${scanName}/$(basename "$parmScanFile").copy"

    # Reading list of parameters to change
    parmNames=($(sed -n '3p' "$parmScanFile"))
    # For each parameter, which case file is it found in?
    parmFiles=($(sed -n '4p' "$parmScanFile"))
    if [ ${#parmNames[@]} -eq 0 ] || [ ${#parmNames[@]} -ne ${#parmFiles[@]} ]; then
        echo "ERROR: line 3 of $parmScanFile lists ${#parmNames[@]} parameter name(s) but" >&2
        echo "       line 4 lists ${#parmFiles[@]} file(s). They must match and be non-empty." >&2
        return 1
    fi
    # Length of list of new cases to be generated (ignore empty lines including trailing ones)
    nCases=$(($(grep -v '^[[:space:]]*$' "$parmScanFile" | wc -l) - 4))
    echo nCases: $nCases
    # Fixed width, so that growing a scan past a power of ten does not renumber the
    # cases that already exist. Assumes fewer than 10000 cases.
    nDigits=4

    # Running through cases first to generate them and then execute script
    # if needed
    casesCreated=false
    local bgPids=()
    trap 'kill "${bgPids[@]}" 2>/dev/null; wait "${bgPids[@]}" 2>/dev/null' INT TERM
    for ((j=0; j<2; j++)); do #Creating cases in 1st pass, executing them in 2nd
        #Line to read in parm file 
        parmLineNumber=4
        for ((i=0; i<nCases; i++)); do
            caseNumber=$(printf "%0${nDigits}d" "$i")
            # Go to next parameter line in parm file ignoring pure white space lines
            while :; do
                parmLineNumber=$((parmLineNumber + 1))
                caseParmString=$(sed -n "${parmLineNumber}p" "$parmScanFile")

                # If the line is NOT only whitespace, stop the loop
                if [[ ! "$caseParmString" =~ ^[[:space:]]*$ ]]; then
                    break
                fi
            done
            #Read case parm line treating content of double quotation as single field
            IFS=$'\n' read -r -d '' -a caseParms < <(echo "$caseParmString" | xargs -n 1)
            #Name of current case directory
            caseName=${scanName}/${caseNumber}

            # Creating case that do not already exist
            if [ ! -d "$caseName" ] && [ "$casesCreated" = false ]; then
                echo Creating case $caseName
                cp -r $baseCase $caseName
                # Writing case parameters to parmScannerParms file in case dir
                caseParmFile=$caseName/parmScannerParms
                echo -n "$caseName: " >> $caseParmFile
                # Running through all parameters to be changed in specific case
                for m in ${!parmNames[*]}
                do
                    parmName=${parmNames[$m]}
                    parmFile=${parmFiles[$m]}
                    parmValue=${caseParms[$m]}
                    echo -n "    $parmName: $parmValue" >> $caseParmFile
                    # setDictEntry, from dictator, deliberately refuses to add a
                    # parameter that is not already there. Failures must be loud:
                    # otherwise the case silently keeps the baseCase value while
                    # parmScannerParms claims the requested one.
                    if ! setDictEntry "${caseName}/${parmFile}" "$parmName" "$parmValue"
                    then
                        echo >> $caseParmFile
                        echo "ERROR: aborting scan while creating $caseName" >&2
                        return 1
                    fi
                done
                # Adding new line to caseParmFile
                echo >> $caseParmFile
                # Writing case parms to terminal
                cat $caseParmFile
                # Adding case numer and parms to parmScannerParms in scan dir
                cat $caseParmFile >> $scanName/parmScannerParms
            fi

            # Running execScript in case if specified by user
            if [ "$casesCreated" = true ] && [ -n "$execScript" ]; then
                # A case is run at most once. The log.$execScript file is created by the
                # output redirection below, i.e. the moment the job is launched, so cases
                # that are still running are skipped too. Remove it to rerun a case.
                if [ -f "$caseName/log.$execScript" ]; then
                    echo "Skipping $caseName ($execScript already run - remove log.$execScript to rerun)"
                # Running several jobs simultaneously in the background if specified by the user
                elif [ "$runParallel" = true ]; then
                    # Limiting the number of simultaneous background jobs to maxJobs if specified by the user
                    if (( maxJobs > 0 )); then
                        while true; do
                            local running=0
                            for pid in "${bgPids[@]}"; do
                                kill -0 "$pid" 2>/dev/null && (( running++ )) || true
                            done
                            (( running < maxJobs )) && break
                            echo "Reached max parallel jobs ($maxJobs). Waiting..."
                            sleep 10
                        done
                    fi
                    echo "Running script $execScript in $caseName"
                    ( cd "$caseName" && ./"$execScript" > "log.$execScript" 2>&1 ) &
                    bgPids+=($!)
                else # Run jobs one at a time in the foreground
                    echo "Running script $execScript in $caseName"
                    ( cd "$caseName" && ./"$execScript" 2>&1 | tee "log.$execScript" )
                fi
            fi
        done
        casesCreated=true
    done
    if [ "$runParallel" = true ] && (( ${#bgPids[@]} > 0 )); then
        wait "${bgPids[@]}"
    fi
)


# Pad the columns of a white space separated file so they line up, rewriting the
# file in place. Intended for keeping a parmFile readable after rows have been
# added or edited by hand.
# Known limitation: does not respect double quotation, so a value containing
# spaces is treated as several columns and pushed apart.

columnAlign() {
    local input_file="$1"
    if [ $# -ne 1 ]; then
        echo "Usage: columnAlign <filename>"
        return 1
    fi

    if [ ! -f "$input_file" ]; then
        echo "Error: File $input_file not found"
        return 1
    fi

    local temp_file
    temp_file=$(mktemp)
    local max_cols=0
    local -a max_widths

    # First pass: Determine the number of columns and their maximum widths
    while IFS= read -r line; do
        [ -z "$line" ] && continue
        local col_values
        read -ra col_values <<< "$line"
        local cols=${#col_values[@]}
        (( cols > max_cols )) && max_cols=$cols
        for ((i=0; i<cols; i++)); do
            local width=${#col_values[$i]}
            if [ "${max_widths[$i]:-0}" -lt "$width" ]; then
                max_widths[$i]=$width
            fi
        done
    done < "$input_file"

    # Second pass: Format the output with proper spacing
    while IFS= read -r line; do
        if [ -z "$line" ]; then
            echo "" >> "$temp_file"
            continue
        fi
        local col_values
        read -ra col_values <<< "$line"
        local formatted_line=""
        for ((i=0; i<${#col_values[@]}; i++)); do
            local value=${col_values[$i]}
            formatted_line+="$value"
            if [ $i -lt $((max_cols - 1)) ] && [ $i -lt $((${#col_values[@]} - 1)) ]; then
                local padding=$((max_widths[$i] - ${#value} + 2))
                for ((j=0; j<padding; j++)); do
                    formatted_line+=" "
                done
            fi
        done
        echo "$formatted_line" >> "$temp_file"
    done < "$input_file"

    # Writing through cat rather than mv keeps the file's mode and ownership; mv
    # would leave the mktemp file's private 600 in their place. A read-only file
    # fails here, and that must not be reported as a success.
    if ! cat "$temp_file" > "$input_file"; then
        rm -f "$temp_file"
        echo "Error: could not write $input_file" >&2
        return 1
    fi
    rm -f "$temp_file"
    echo "File $input_file has been aligned successfully."
}

